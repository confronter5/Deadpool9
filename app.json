{
  "name": "Deadpool V4",
  "description": "A WhatsApp Bot Created By Confronter - Optimized for Heroku",
  "logo": "https://telegra.ph/file/f6230a0cb5b118fa01561.jpg",
  "keywords": ["bot", "whatsapp", "automation", "baileys"],
  "success_url": "/",
  "stack": "heroku-22",
  "env": {
    "SESSION_ID": {
      "description": "Your WhatsApp session ID (get from pairing code)",
      "value": "",
      "required": true
    },
    "PREFIX": {
      "description": "Bot command prefix (e.g., . ! #)",
      "value": "."
    },
    "OWNER_NUMBER": {
      "description": "Your phone number with country code (e.g., 254796283064)",
      "value": "254796283064",
      "required": true
    },
    "OWNER_NAME": {
      "description": "Owner name displayed in bot",
      "value": "Confronter"
    },
    "BOT_NAME": {
      "description": "Bot name",
      "value": "DEADPOOL-V4"
    },
    "AUTO_VIEW_STATUS": {
      "description": "Auto-view WhatsApp statuses (true/false)",
      "value": "true"
    },
    "AUTO_READ_STATUS": {
      "description": "Auto-read WhatsApp statuses (true/false)",
      "value": "true"
    },
    "AUTO_LIKE_STATUS": {
      "description": "Auto-like WhatsApp statuses (true/false)",
      "value": "true"
    },
    "PUBLIC_MODE": {
      "description": "Public or private mode (public/private)",
      "value": "public"
    },
    "PM_PERMIT": {
      "description": "PM permit for private messages (yes/no)",
      "value": "yes"
    },
    "ANTICALL": {
      "description": "Block voice/video calls (true/false)",
      "value": "false"
    },
    "WELCOME": {
      "description": "Welcome messages for groups (true/false)",
      "value": "false"
    },
    "DATABASE_URL": {
      "description": "MongoDB or PostgreSQL database URL (optional)",
      "value": "",
      "required": false
    },
    "PACKNAME": {
      "description": "Sticker pack name",
      "value": "DEADPOOL-V4"
    },
    "AUTHOR": {
      "description": "Sticker pack author",
      "value": "CONFRONTER"
    }
  },
  "buildpacks": [
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git"
    },
    {
      "url": "https://github.com/heroku/heroku-buildpack-nodejs.git"
    }
  ],
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
